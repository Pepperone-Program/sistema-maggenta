# O ranking deve permanecer desativado ate concluir migration, rebuild, golden,
# benchmark e remover a reordenacao no consumidor publico.
SEARCH_RANKING_PERCENTAGE=0
SEARCH_PREFLIGHT_ALLOW_RANKING=false
SEARCH_SHADOW_PERCENTAGE=0
SEARCH_WRITE_SYNC_ENABLED=false
SEARCH_RANKING_VERSION=v4
# Tamanho de cada lote de hidratacao; nao limita o total de resultados.
SEARCH_HYDRATION_BATCH_SIZE=250
SEARCH_RANKING_PLAN_MAX_ENTRIES=100
SEARCH_TIMEOUT_MS=3000
SEARCH_MAX_CONCURRENT=7
SEARCH_RESULT_CACHE_TTL_SECONDS=60
SEARCH_AUTOCOMPLETE_CACHE_TTL_SECONDS=300
SEARCH_DICTIONARY_TTL_MS=60000
SEARCH_CURSOR_SECRET=replace-with-a-random-secret
SEARCH_PUBLIC_DEFAULT_EMPRESA_ID=1
SEARCH_EXPECTED_REPLICAS=1
DB_MIGRATION_LOCK_WAIT_TIMEOUT=30
SEARCH_CIRCUIT_BREAKER_FAILURES=5
SEARCH_CIRCUIT_BREAKER_OPEN_MS=30000
SEARCH_ANALYTICS_QUEUE_LIMIT=1000
SEARCH_ANALYTICS_BATCH_SIZE=50
SEARCH_ANALYTICS_FLUSH_MS=1000
SEARCH_ANALYTICS_RETENTION_DAYS=180
METRICS_TOKEN=replace-with-a-random-secret

# Geracao de titulo e descricao de produtos com IA
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
AI_DESCRIPTION_MODEL=gemini-3.1-flash-lite
AI_DESCRIPTION_DEEPSEEK_MODEL=deepseek-v4-pro
AI_DESCRIPTION_DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
AI_DESCRIPTION_GROQ_MODEL=qwen/qwen3.8-27b
AI_DESCRIPTION_GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
AI_DESCRIPTION_GROQ_TEXT_MODEL=openai/gpt-oss-120b
AI_DESCRIPTION_GROQ_FAST_MODEL=openai/gpt-oss-20b
# Limites por processo. As cinco filas continuam ativas, mas as chamadas sao espacadas.
AI_DESCRIPTION_GEMINI_RPM=15
AI_DESCRIPTION_GROQ_RPM=30
AI_DESCRIPTION_MAX_IMAGES=3
AI_DESCRIPTION_GROQ_MAX_IMAGES=1
AI_DESCRIPTION_MAX_OUTPUT_TOKENS=1024
# Hosts adicionais, separados por virgula. O host de SUPABASE_URL ja e permitido automaticamente.
AI_DESCRIPTION_ALLOWED_IMAGE_HOSTS=
AI_DESCRIPTION_REQUEST_TIMEOUT_MS=90000
AI_DESCRIPTION_GEMINI_MAX_RETRIES=2
AI_DESCRIPTION_DEEPSEEK_MAX_RETRIES=2
AI_DESCRIPTION_GROQ_MAX_RETRIES=4
AI_DESCRIPTION_GEMINI_COOLDOWN_MS=30000
AI_DESCRIPTION_GEMINI_QUOTA_COOLDOWN_MS=3600000
AI_DESCRIPTION_DEEPSEEK_COOLDOWN_MS=60000
AI_DESCRIPTION_GROQ_COOLDOWN_MS=60000
# Falhas transitórias do lote aguardam e tentam novamente por até sete dias.
AI_DESCRIPTION_BATCH_MAX_WAIT_HOURS=168
AI_DESCRIPTION_BATCH_RETRY_MIN_MS=60000
AI_DESCRIPTION_BATCH_RETRY_MAX_MS=3600000
AI_DESCRIPTION_EMPRESA_ID=1
